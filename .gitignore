npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python helper
.py-helper/.venv/
.py-helper/.idea/
.py-helper/client_secrets.json
.py-helper/token.json
__pycache__/
*.py[cod]
